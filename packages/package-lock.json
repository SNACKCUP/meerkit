{
  "name": "meerkit-packages",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "meerkit-packages",
      "workspaces": [
        "meerkit",
        "create-meerkit"
      ]
    },
    "create-meerkit": {
      "version": "0.1.0-rc.4",
      "license": "MIT",
      "dependencies": {
        "@snackcup/meerkit": "^0.1.0-rc.4"
      },
      "bin": {
        "create-meerkit": "bin/create-meerkit.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "meerkit": {
      "name": "@snackcup/meerkit",
      "version": "0.1.0-rc.4",
      "license": "MIT",
      "bin": {
        "meerkit": "bin/meerkit.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@snackcup/meerkit": {
      "resolved": "meerkit",
      "link": true
    },
    "node_modules/create-meerkit": {
      "resolved": "create-meerkit",
      "link": true
    }
  }
}
