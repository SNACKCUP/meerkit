APP_ENV=local
LOG_LEVEL=INFO
# json | text. 비우면 APP_ENV=local은 text, 그 밖(운영)은 json (한 줄에 JSON 하나, 로그 수집용)
LOG_FORMAT=
# 기본 DB: docker-compose.yml의 db (`npx @snackcup/meerkit setup` 또는 `docker compose up -d db`). 로컬 전용 계정입니다
DATABASE_URL=postgresql+psycopg://starter:starter@localhost:5432/starter
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres  # 대체용: Supabase 로컬 (루트에서 `npm run db:start`)
# pytest 전용 DB (로컬 전용!). 처음 실행할 때 자동으로 만들고 마이그레이션합니다. 이름은 _test로 끝나야 합니다
TEST_DATABASE_URL=postgresql+psycopg://starter:starter@localhost:5432/meerkit_test
# 32자 이상 임의 문자열. 운영에서는 반드시 바꾸세요 (APP_ENV=production에서 짧거나 이 예시 값이면 서버가 시작하지 않음) (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
# 인증번호·재설정 토큰 해시에도 쓰므로, 바꾸면 발송된 인증번호·재설정 링크는 무효가 됩니다
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-bytes-or-more
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# 배포(https)에서는 true
COOKIE_SECURE=false
# Swagger(/docs)·OpenAPI 공개 여부. 운영에서 API 목록을 숨기려면 false
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# 로그인 잠금: 연속 N회 실패하면 M분 잠금 (프론트 meerkit.config.ts의 login과 같은 값으로). 0이면 끔
LOGIN_LOCK_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# 가입·이메일 변경 때 이메일 인증 필수 (true면 프론트 signup.emailVerification도 true로)
SIGNUP_EMAIL_VERIFICATION_REQUIRED=true
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# 탈퇴 후 이 기간(일)이 지나면 개인정보 삭제 (uv run python -m app.users.purge, 매일 실행)
ACCOUNT_RETENTION_DAYS=365
EMAIL_VERIFICATION_RETENTION_DAYS=7

# 메일 링크가 여는 프론트 주소 (비밀번호 재설정: <주소>/reset-password?token=...)
FRONTEND_BASE_URL=http://localhost:3000

# 메일 발송 방법
#   console: 보내지 않고 로그로만 (본문은 APP_ENV=local일 때만 출력) ← 로컬 기본값
#   smtp:    SMTP로 발송. 로컬은 Mailpit(`docker compose up -d mailpit`, 받은 메일 http://localhost:8025)
#            운영은 메일 업체의 SMTP (예: 587 포트면 MAIL_SMTP_STARTTLS=true, 465 포트면 MAIL_SMTP_SSL=true)
#            업체·도메인·DNS 설정 순서는 docs/mail-setup.md
MAIL_BACKEND=console
MAIL_FROM=MeerKit <no-reply@localhost>
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
# 업체 SMTP 계정. 실제 값은 서버의 .env에만 넣고 커밋·공유하지 마세요
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
# 같은 이메일로 보내는 인증·재설정 메일: 최소 간격(초)과 하루 한도
MAIL_COOLDOWN_SECONDS=60
MAIL_DAILY_LIMIT=10

# LLM (app/llm). openai | fake (fake: 키 없이 예시 응답, 로컬·테스트 전용 — 운영에서는 시작을 막음)
# 키가 비어 있으면 서버는 뜨고 AI 기능만 503 LLM_NOT_CONFIGURED 로 응답합니다
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# 실제 값은 .env 에만. 커밋·공유하지 마세요
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# 공급자 SDK 재시도(네트워크·일시 오류) / 응답 형식이 틀릴 때 다시 묻는 횟수
LLM_MAX_RETRIES=2
LLM_OUTPUT_RETRIES=1
# 입력 글자 수 상한 (비용 폭주·시간 초과 방지). 넘으면 413 LLM_INPUT_TOO_LONG
LLM_MAX_INPUT_CHARS=20000

# 파일 저장소 (app/storage, 프로필 이미지 등). s3 | memory(테스트 전용 — 운영에서는 시작을 막음) | 빈 값
# 비어 있으면 서버는 뜨고 이미지 올리기만 503 STORAGE_NOT_CONFIGURED. 설정 순서: docs/storage-setup.md
# 아래는 로컬 Supabase 기준. 키는 `npx supabase status` 의 S3 Access Key / S3 Secret Key
STORAGE_BACKEND=
STORAGE_BUCKET=meerkit-public
# 비공개 버킷 (고객 문서 원본 등, get_private_storage). 공개 버킷과 다른 이름이어야 함
STORAGE_PRIVATE_BUCKET=meerkit-private
STORAGE_S3_ENDPOINT_URL=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_REGION=local
# 실제 값은 .env 에만. 커밋·공유하지 마세요 (버킷 전체를 읽고 쓰는 키)
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:54321/storage/v1/object/public/meerkit-public

# 소셜 로그인 (app/social). 공급자는 CLIENT_ID 와 CLIENT_SECRET 이 모두 있어야 켜집니다 (비어 있으면 404)
# Redirect URI = <SOCIAL_REDIRECT_BASE_URL>/<provider>/callback  → 공급자 콘솔에 똑같이 등록. 설정 순서: docs/social-oauth-setup.md
# 로그인 후에는 FRONTEND_BASE_URL/auth/<provider>/callback 으로 돌아갑니다
SOCIAL_REDIRECT_BASE_URL=http://localhost:3000/api/auth
GOOGLE_CLIENT_ID=
# 실제 값은 .env 에만. 커밋·공유하지 마세요
GOOGLE_CLIENT_SECRET=

# 로컬 테스트용 관리자(MASTER) 계정 (로컬 전용! 운영에서 쓰지 마세요)
# 만들기: uv run python -m app.users.seed  (로그인은 SEED_ADMIN_USER_ID 로)
SEED_ADMIN_USER_ID=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=meerkit-local-admin
SEED_ADMIN_NAME=관리자
